# Supabase public configuration (safe for the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# OpenRouter server-only configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Public production URL, for example https://logosofico.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
